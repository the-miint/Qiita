# Declarative build spec for the long-read-assembly `checkm` image (CheckM),
# consumed by scripts/build-sif.sh via `build-sif.sh long-read-assembly checkm`.
# `source`d as bash — plain KEY="value" pairs, no logic. One of four per-tool
# images the workflow ships; see sif-build.d/assemble.env for the layout.

# Output SIF filename; MUST match the `container:` on the `checkm` step of some
# workflow YAML (test_sif_build_spec.py enforces this). Bumped to 1.0.1 with the
# residue pass, because sync can RE-ENABLE 1.0.0 (it clears its own
# auto-deprecate-sync disable when the YAML is synced again) and an image rebuilt in
# place would then write residue quality rows under the 1.0.0 processing_idx that
# already exists.
#
# The cost, stated rather than glossed: NOTHING builds -checkm-1.0.0.sif now, so
# 1.0.0.yaml names an image this tree cannot produce. 1.0.0 is RETIRED, not
# reproducible — the only copy is the one already on the deploy host, which the
# deploy checklist tells the operator to keep.

SIF_FILENAME="long-read-assembly-checkm-1.0.1.sif"

# The def this image builds (workflow-relative).
DEF_FILE="checkm.def"

# This image's in-repo build inputs — scopes the idempotency hash to this image.
# lcg_split.py and residue_split.py split circular.fa and the unbinned residue into
# the per-contig FASTAs CheckM scores; miint_connect.py is the module they import for
# the staged-miint connection and the shared write. The last two are qiita-common's
# own files, staged beside the def by build-sif.sh rather than copied: chunking.py
# carries the canonical sequence-hash expression residue_split subtracts binned
# contigs with (the SAME file assembly_hash imports), and duckdb_miint.py carries
# `is_empty_sequence_file`, the decompressed-stream check that drops an empty bin
# before `read_fastx` is handed it. All are %files-copied, so an edit to any changes
# the image.
HASH_INPUTS="checkm.sh lcg_split.py residue_split.py miint_connect.py ../../qiita-common/src/qiita_common/chunking.py ../../qiita-common/src/qiita_common/duckdb_miint.py"

# No SOURCES: checkm-genome + its external binaries are fetched from bioconda in
# %post. The ~1.4 GB CheckM reference DB is NOT baked in — it is bind-mounted at
# run time (CHECKM_DATA_PATH; see checkm.sh + DEPLOY_CHECKLIST.md).

# Idempotency + post-build verification. `micromamba env list` prints the tool
# env; asserting `checkm` proves it resolved.
VERIFY_CMD="micromamba env list"
VERIFY_MATCH="checkm"
