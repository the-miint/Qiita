Bootstrap: docker
From: mambaorg/micromamba:1.5.8

# Per-tool image for the long-read-assembly `binning` step (metawrap: metabat2 +
# maxbin2 + concoct). One of four single-tool images the workflow ships; see
# assemble.def for the split rationale. Invoked as
# `apptainer exec <sif> /opt/qiita/binning.sh` (per-step entrypoint), so the
# %runscript is unused.
#
# This is the heaviest bioconda solve of the four images — metaWRAP's scripts plus
# every binner and aligner they shell out to, in one env — so this SIF is the
# slowest to build.

%labels
    workflow long-read-assembly
    tool binning
    version 1.0.0

%files
    # Workflow-agnostic output-dir → manifest.json walker, copied from _shared
    # (build-sif.sh mirrors the repo layout so this relative path resolves).
    ../_shared/manifest_writer.py /opt/qiita/manifest_writer.py
    # Shared entrypoint helpers (params.json parsing, manifest + mode contract).
    ../_shared/_lib.sh /opt/qiita/_lib.sh
    # This image's per-step entrypoint.
    binning.sh /opt/qiita/binning.sh
    # Required-tool assertion, shared by %test and the spec's VERIFY_CMD.
    binning-verify.sh /opt/qiita/binning-verify.sh

%environment
    export MAMBA_ROOT_PREFIX=/opt/conda
    export PATH=/opt/conda/bin:${PATH}

%post
    set -e
    export MAMBA_ROOT_PREFIX=/opt/conda
    # jq (params.json), gawk, pigz (binning.sh decompresses reads), procps,
    # findutils — the base utilities the entrypoint relies on outside the tool env.
    # `python` is REQUIRED, not a nicety: _lib.sh's qiita_finish runs
    # `python3 /opt/qiita/manifest_writer.py` to emit manifest.json, and EVERY
    # step must write one (the backend verifies it before registering outputs).
    # The micromamba base image ships no Python, so without this every step of
    # this workflow dies at its final line — after doing all its real work.
    # PINNED, like bcl-convert's python3.11: unpinned, a later rebuild silently
    # moves the interpreter major version under manifest_writer.py.
    micromamba install -y -n base -c conda-forge jq gawk pigz procps-ng findutils python=3.11

    # One env for this tool. Channels bioconda + conda-forge.
    #
    # `metawrap-mg` is metaWRAP's SCRIPTS ONLY — it declares none of the tools
    # those scripts invoke, so it must NOT be installed alone. Every binner has
    # to be named explicitly; see binning-verify.sh for the derivation of this
    # list from metaWRAP's own binning.sh. Two packages that look like
    # alternatives and are not:
    #   - the full `metawrap` bioconda package is unsolvable (1.0/1.1 pin a
    #     cairo that no longer exists; 1.2 pins megahit/salmon with
    #     irreconcilable icu/libboost/zlib conflicts). Unqualified `metawrap`
    #     also resolves to an UNRELATED conda-forge package (0.0.2).
    #   - `metawrap-binning` declares bowtie2 (invoked zero times by the module)
    #     and omits both bwa and metabat2.
    # Three version constraints, each for a stated failure this image already hit
    # or is one re-solve away from. binning-verify.sh asserts the resolved
    # versions at BUILD time, so a solve that drifts fails the build rather than
    # shipping green — keep the two files in lockstep.
    #   maxbin2 >=2.2.6 — 2.2.1's executable is `MaxBin`, not the `run_MaxBin.pl`
    #     metaWRAP invokes. An unpinned solve takes 2.2.1; the image passes every
    #     build check and then fails inside the job.
    #   samtools =1.10 — binning.sh reads the staged BAM's @SQ header and reorders
    #     the assembly to it with `samtools faidx`, whose region-order and
    #     missing-region behaviour the reorder's fail-loud guard rests on; metaWRAP's
    #     concoct block also runs `samtools index` over work_files/*.bam.
    #   metabat2 =2.15 — it OWNS `jgi_summarize_bam_contig_depths` (verified in
    #     the deployed image's conda-meta), the tool whose "is not sorted!"
    #     rejection this workflow was fixed for and whose depth matrix metabat2
    #     then requires to agree with the assembly's contig order. It adjudicates
    #     both acceptance criteria the entrypoint is built around, so pinning it is
    #     what keeps those criteria from moving under us.
    # samtools and metabat2 were BOTH transitive before this: neither was named
    # here, so both arrived through metawrap-mg's solve. A dry-run solve on this
    # def's own base (mambaorg/micromamba:1.5.8) with these pins reproduces every
    # build string the deployed image ships, samtools h2e538c0_3 and metabat2
    # h986a166_1 included.
    micromamba create -y -n metawrap -c bioconda -c conda-forge \
        metawrap-mg bwa samtools=1.10 metabat2=2.15 "maxbin2>=2.2.6" concoct

    # concoct's `vbgmm` C-extension links libgfortran.so.3, but the metawrap solve
    # ships only libgfortran.so.5, so `import vbgmm` dies at RUNTIME with
    # `ImportError: libgfortran.so.3` — metaWRAP's concoct binner then fails and,
    # because metaWRAP exits non-zero when any binner hard-fails, takes the whole
    # step down (metabat2 + maxbin2 succeed regardless). The old conda-forge
    # `libgfortran` (3.0.0) provides .so.3 and COEXISTS with libgfortran5 (a
    # different package — both .so files remain), so this restores concoct without
    # perturbing the pinned solve. Probed on a real assembly: `import vbgmm` goes
    # from ImportError to OK, and metaWRAP runs concoct to completion. Separate
    # `install` (not on the create line) so it can't reshape the metawrap solve.
    # binning-verify.sh asserts `import vbgmm` at BUILD time — the plain presence/
    # runnability check could not, since the failure is a Python ImportError
    # (exit 1), not a loader verdict (126/127).
    micromamba install -y -n metawrap -c conda-forge libgfortran=3.0.0

    chmod 0755 /opt/qiita/_lib.sh /opt/qiita/binning.sh /opt/qiita/binning-verify.sh
    chmod 0644 /opt/qiita/manifest_writer.py

    micromamba clean -a -y

%test
    set -e
    # `apptainer build` runs %test inside the FINISHED image — a read-only
    # filesystem — with HOME=/root, a path that lives in that image. libmamba
    # creates a cache dir under $HOME and hard-aborts when it cannot, which failed
    # the very first build of these images. At RUN time this never bites: the SLURM
    # payload passes `--home <workspace>`, a writable dir. So give the test a
    # writable HOME too — and ONLY that, because HOME is the only thing production
    # sets. (Setting XDG_CACHE_HOME as well would be a config no job ever runs
    # under, and would hide it if HOME alone ever stopped being sufficient.) A
    # fresh mktemp dir rather than bare /tmp: private, and it does not leave
    # root-owned litter on the build host.
    export HOME="$(mktemp -d)"
    micromamba env list | grep -q metawrap
    micromamba run -n metawrap metawrap --version >/dev/null 2>&1 || micromamba run -n metawrap metawrap -h >/dev/null
    # The two lines above pass on an env with ZERO binners — that is exactly how
    # a binner-less image shipped. This asserts every tool metaWRAP actually
    # invokes, and fails the BUILD when one is absent.
    /opt/qiita/binning-verify.sh
    # Base utilities the entrypoints actually invoke — assert each one, since the
    # whole point of this %test is to fail the BUILD on a missing runtime dep
    # rather than at the end of a long job.
    jq --version
    gawk --version >/dev/null
    find --version >/dev/null
    pigz --version
    python3 -c "import importlib.util as u; s=u.spec_from_file_location('mw','/opt/qiita/manifest_writer.py'); m=u.module_from_spec(s); s.loader.exec_module(m)"
    # Lockstep guard (mirrors bcl-convert): if _lib.sh's manifest line ever stops
    # matching what %post installs, fail the BUILD. This bug class — an entrypoint
    # reaching for an interpreter the image lacks — is what killed every step of
    # this workflow at its final line.
    grep -q 'python3 /opt/qiita/manifest_writer\.py' /opt/qiita/_lib.sh
    # Guard the entrypoint stays wired to its env.
    grep -q 'micromamba run -n metawrap metawrap' /opt/qiita/binning.sh

%runscript
    echo "long-read-assembly-binning image: invoke the step entrypoint, e.g." >&2
    echo "  apptainer exec <sif> /opt/qiita/binning.sh" >&2
    exit 64
